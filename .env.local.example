# Supabase-nøkler — kopier denne fila til ".env.local" og fyll inn ekte verdier.
# Du finner verdiene i Supabase: Project Settings -> Data API (URL) og API Keys.
# IMPORTANT: .env.local skal ALDRI committes til git (den er allerede git-ignorert).

# Adressen til Supabase-prosjektet ditt, f.eks. https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Den offentlige "anon"-nøkkelen (trygg i nettleseren, beskyttet av Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
